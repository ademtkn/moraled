{
  "name": "moraled-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://moraled.com",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node scripts/validate-certificates.js && vite build && node scripts/generate-route-html.js",
    "preview": "vite preview",
    "dev:soon": "vite --config vite.soon.config.js",
    "build:soon": "vite build --config vite.soon.config.js",
    "preview:soon": "vite preview --config vite.soon.config.js",
    "lint": "eslint .",
    "test:certificates": "node --test scripts/certificates.test.js",
    "deploy": "npm run build:soon && gh-pages -d build",
    "deploy:full": "npm run build && gh-pages -d build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "aos": "^2.3.4",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.5.8",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.2",
    "react-slick": "^0.30.2",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
